          "id": "d4c3b2c1-47b7-4e50-ba72-272d704b74f6",
          "name": "Job 1 - Check if age is over 18 months",
          "body": "  fn(state => {\n    console.log(state);\n    \n    if (state.data.age_in_months > 18) {\n      console.log('Eligible for program.');\n      return state;\n    }\n    else { throw 'Error, patient ineligible.' }\n  });\n",
